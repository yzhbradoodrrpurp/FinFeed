# Copy to /etc/finfeed/backend.env, owned by root, mode 600.
# systemd EnvironmentFile syntax: quote values containing spaces; no export.
PUBLIC_ORIGIN=https://YOUR_BACKEND_HOST
FRONTEND_ORIGIN=https://finfeed-research.vercel.app
DATABASE_URL=
# Copy existing provider configuration privately; never create new accounts.
FRED_API_KEY=
ALPHAVANTAGE_API_KEY=
YAHOO_SESSION_MODE=anonymous
YAHOO_PROXY_URL=
MIHOMO_CONFIG_B64=
FINFEED_EMAIL_PROVIDER=gmail
FINFEED_EMAIL_FROM=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
FINFEED_NOTIFICATION_CRON_TOKEN=
